# CobraLearn InnoTechCore Showcase & Admin CMS
# Environment Configuration Template
# DO NOT COMMIT SECRETS TO VERSION CONTROL

# Database Configuration (Supabase PostgreSQL - ap-south-1)
# Transaction pooler URL (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (port 5432) for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Project Credentials
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Outbound Email Service (Resend) - Server Only (Never prefix with VITE_ or expose to client)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM_ADDRESS="CobraLearn Innotechcore <support@cobralearn.com>"
EMAIL_REPLY_TO="support@cobralearn.com"

# Rate Limiting & Abuse Protection — Server Only (Never prefix with VITE_ or expose to client)
# Dedicated high-entropy secret (e.g. 64-char hex / 256-bit random string) used for keyed HMAC
# hashing of sensitive account identifiers and IP addresses in rate-limit storage and security logs.
# Production must use a strong, dedicated, randomly generated secret (e.g. `openssl rand -hex 32`).
# Do NOT reuse SUPABASE_SERVICE_ROLE_KEY or any other credential as this secret.
RATE_LIMIT_SECRET="your-strong-random-rate-limit-secret-here"

